name: "sam3_model"
backend: "python"
max_batch_size: 4

input[
    {
        name: "RAW_IMAGE"
        data_type: TYPE_UINT8
        dims: [-1, -1, 3]
    },
    {
        name: "TEXT_PROMPT"
        data_type: TYPE_STRING
        dims: [1]
    }
]

output[
    {
        name: "SEGMENTATION_MASK"
        data_type: TYPE_FP32
        dims: [-1, -1]
    }
]

dynamic_batching{
    max_queue_delay_microseconds: 5000
}

instance_group[
    {
      count: 8
      kind: KIND_CPU 
    }
]