name: "vision_encoder"
platform: "tensorrt_plan"

max_batch_size: 4

input[
    {
        name: "images"
        data_type: TYPE_FP32
        dims: [3, 1008, 1008]
    }
]

output[
    {
        name: "fpn_feat_0"
        data_type: TYPE_FP32
        dims: [256, 288, 288]
    },
    {
        name: "fpn_feat_1"
        data_type: TYPE_FP32
        dims: [256, 144, 144]
    },
    {
        name: "fpn_feat_2"
        data_type: TYPE_FP32
        dims: [256, 72, 72]
    },
    {
        name: "fpn_pos_2"
        data_type: TYPE_FP32
        dims: [256, 72, 72]
    }
]

dynamic_batching{
    preferred_batch_size: [2, 4]
    max_queue_delay_microseconds: 5000
}

instance_group[
    {
        count: 2
        kind: KIND_GPU
        gpus: [0]
    }
]